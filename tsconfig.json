{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"checkJs": false,
		"allowJs": false,
		"types": [
			"$app/types",
			"@cloudflare/workers-types",
			"./worker-configuration.d.ts",
			"@playwright/test"
		],
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"],
			"$lib": ["./src/lib/index.ts"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"vite.config.ts",
		"drizzle.config.ts",
		"playwright.config.ts",
		"tests/**/*.ts"
	],
	"exclude": ["node_modules", ".svelte-kit", "build", ".wrangler", "drizzle"]
}
