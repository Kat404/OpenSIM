{
	"name": "opensim",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "OpenSIM — Sistema Integral Modular for TecNM Morelia. FOSS rewrite in SvelteKit 3 + Svelte 5 + Cloudflare D1.",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "wrangler d1 execute opensim --local --file=./src/lib/server/db/seed.sql"
	},
	"dependencies": {
		"drizzle-orm": "0.45.3",
		"lucide-svelte": "1.0.1",
		"pdf-lib": "1.17.1",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@cloudflare/workers-types": "^5.20261001.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-cloudflare": "8.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@types/node": "26.6.4",
		"drizzle-kit": "0.31.11",
		"svelte": "5.57.1",
		"svelte-check": "4.6.0",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"vitest": "5.0.3",
		"wrangler": "4.147.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}