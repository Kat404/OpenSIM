node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Wrangler generated types (regenerated on every build via `wrangler types`)
/worker-configuration.d.ts

# Dev artifacts (contain PBKDF2 hash + salt for the test student)
/src/lib/server/db/seed-password.sql

# Playwright run output (transient). `playwright/` holds .auth/storage.json —
# the session state tests/e2e/axe/*.spec.ts load via test.use({ storageState }).
# Regenerated by tests/e2e/setup/auth.setup.ts on every run, so no .gitkeep is
# needed. A negation could not re-include it anyway: git never descends into an
# excluded directory.
/test-results/
/playwright/

# Playwright JSON run artefacts — regenerated on every run (results.json alone
# reaches ~19 MB of pure telemetry). The durable a11y narrative lives in
# docs/a11y-audit.md, so the JSON is regenerable evidence, not a record.
/tests/e2e/reports/*.json

# e2e — agentic end-to-end runner (`pnpm dlx e2e init`).
#
# `.e2e/` is run output, not source. Two of these entries are not
# regenerable evidence and are ignored on purpose:
#
#   .e2e/cache/     the replay cache. It maps each agent step to the DOM
#                   snapshot it was decided from, and those snapshots carry
#                   whatever the page rendered — on this app that includes the
#                   demo student's name and control number, because
#                   LayoutHeader prints both on every protected route. So it
#                   is ignored for PII, not only because it goes stale.
#                   Opt-in per e2e docs if that ever changes.
#   .e2e/ai-trace.json  every prompt and completion sent to the model
#                   gateway. That is page content leaving the machine, so it
#                   must never enter a public repository. See e2e.config.ts
#                   for which endpoint receives it.
#
# The rest is bulk regenerable output: run artefacts, logs, videos.
/.e2e/results/
/.e2e/cache/
/.e2e/sessions/
/.e2e/report.json
/.e2e/ai-trace.json
/.e2e/junit.xml
/.e2e/summary.md
/.e2e/logs/
/.e2e/videos/
